# Kopiere diese Datei zu "secrets.env" (im selben Ordner) und trage die Werte ein.
# secrets.env niemals teilen oder hochladen.

# eBay Developer Program -> Application Keys -> Production
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# optional: eBay Partner Network Campaign ID
EBAY_CAMPAIGN_ID=

# Discord-Webhooks (Kanal-Einstellungen -> Integrationen -> Webhooks -> URL kopieren)
WEBHOOK_DEAL_ALERTS=
WEBHOOK_RETRO_GAMES=
WEBHOOK_CLOTHING_DEALS=
WEBHOOK_FREE_DEALS=
